{
  "name": "@guarani/jose",
  "version": "1.0.0",
  "description": "Implementation of the RFCs of the JOSE Working Group.",
  "license": "MIT",
  "homepage": "https://github.com/guaraniframework/node-jose#readme",
  "main": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "prepare": "pnpm exec husky",
    "test": "pnpm exec jest",
    "release": "pnpm run build && pnpm pack --pack-destination release && pnpm publish --access public",
    "postpublish": "rm -rf dist release"
  },
  "bugs": {
    "url": "https://github.com/guaraniframework/node-jose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/guaraniframework/node-jose.git"
  },
  "author": {
    "name": "Revensky",
    "url": "https://github.com/revensky"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "jose",
    "json",
    "web",
    "key",
    "set",
    "keyset",
    "token",
    "signature",
    "encryption",
    "algorithm",
    "jws",
    "jwe",
    "jwk",
    "jwks",
    "jwa",
    "jwt"
  ],
  "dependencies": {
    "@guarani/primitives": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "jest-extended": "^7.0.0",
    "jest-util": "^30.4.1",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "^17.0.7",
    "neostandard": "^0.13.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
